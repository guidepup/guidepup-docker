FROM ubuntu:resolute

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION
ARG GUIDEPUP_VERSION
ARG GUIDEPUP_SETUP_VERSION

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    mkdir -p /opt/guidepup && \
    cd /opt/guidepup && \
    npm init --yes && \
    npm install --no-audit --no-fund --save-exact "@guidepup/guidepup@${GUIDEPUP_VERSION}" && \
    npx --yes "@guidepup/setup@${GUIDEPUP_SETUP_VERSION}" setup --ci && \
    npx --yes "@guidepup/setup@${GUIDEPUP_SETUP_VERSION}" install orca && \
    rm -rf /root/.npm /var/lib/apt/lists/*
